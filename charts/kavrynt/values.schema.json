{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Kavrynt chart values",
  "description": "gateway and operator values are validated by the schemas of their subcharts.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "description": "Other keys are allowed for platform-injected globals.",
      "properties": {
        "watchNamespaces": {
          "type": "array",
          "description": "Namespaces whose MCPServer resources the Gateway routes; empty means all.",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
          }
        }
      }
    },
    "gateway": { "type": "object" },
    "operator": { "type": "object" },
    "networkPolicy": {
      "type": "object",
      "description": "NetworkPolicies that keep MCP traffic on the Gateway path (SPEC-0007).",
      "additionalProperties": false,
      "properties": {
        "mcpServers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "namespaces": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 63,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              }
            }
          }
        },
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "allowedNamespaceLabels": {
              "type": "array",
              "items": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": { "type": "string" }
              }
            },
            "allowedCIDRs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])|[0-9a-fA-F:]+:[0-9a-fA-F:]*/([0-9]|[1-9][0-9]|1[01][0-9]|12[0-8]))$"
              }
            }
          }
        }
      }
    }
  }
}
