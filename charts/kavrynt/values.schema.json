{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Kavrynt chart values",
  "description": "gateway and operator values are validated by the schemas of their subcharts.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "description": "Other keys are allowed for platform-injected globals.",
      "properties": {
        "watchNamespaces": {
          "type": "array",
          "description": "Namespaces whose MCPServer resources the Gateway routes; empty means all.",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
          }
        },
        "upstreamCredentials": {
          "type": "object",
          "description": "Secret in the release namespace with the credentials of MCP servers that declare spec.credential (SPEC-0011).",
          "additionalProperties": false,
          "properties": {
            "secretName": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$"
            }
          }
        },
        "endpoints": {
          "type": "object",
          "description": "Which namespaces MCPServer endpoints may reach (SPEC-0029).",
          "additionalProperties": false,
          "properties": {
            "crossNamespace": {
              "type": "array",
              "description": "Namespace pairs whose MCPServers in from may use endpoints in to.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["from", "to"],
                "properties": {
                  "from": { "type": "string", "maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
                  "to": { "type": "string", "maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" }
                }
              }
            },
            "clusterCIDRs": {
              "type": "array",
              "description": "The cluster's Service and Pod ranges; IP endpoints inside them are refused.",
              "items": { "type": "string", "pattern": "^(([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])|[0-9a-fA-F:]+:[0-9a-fA-F:]*/([0-9]|[1-9][0-9]|1[01][0-9]|12[0-8]))$" }
            }
          }
        },
        "tokenExchangeAudiences": {
          "type": "object",
          "description": "Namespace (or * for all) to the token exchange audiences its MCPServers may request (SPEC-0029).",
          "propertyNames": { "pattern": "^(\\*|[a-z0-9]([-a-z0-9]*[a-z0-9])?)$", "maxLength": 63 },
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^#\\s]+$" }
          }
        }
      }
    },
    "gateway": { "type": "object" },
    "operator": { "type": "object" },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prometheusRule": {
          "type": "object",
          "description": "Alerting rules (SPEC-0010, SPEC-0021).",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "labels": { "type": "object", "additionalProperties": { "type": "string" } },
            "alertLabels": { "type": "object", "additionalProperties": { "type": "string" } },
            "jobs": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "gateway": { "type": "string" },
                "operator": { "type": "string" }
              }
            },
            "errorRatio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "minRequestsPerSecond": { "type": "number", "minimum": 0 },
            "latencyP95Seconds": { "type": "number", "exclusiveMinimum": 0 },
            "notReadyFor": { "type": "string", "pattern": "^[0-9]+[smh]$" },
            "toolErrorRatio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "minToolRequestsPerSecond": { "type": "number", "minimum": 0 },
            "discoveryFailingFor": { "type": "string", "pattern": "^[0-9]+[smh]$" },
            "cloudSyncStaleSeconds": { "type": "integer", "minimum": 60 },
            "auditDeliveryStaleSeconds": { "type": "integer", "minimum": 60 },
            "runbookBaseURL": { "type": "string", "pattern": "^(https://\\S+)?$" }
          }
        },
        "notifications": {
          "type": "object",
          "description": "Alertmanager notifications (SPEC-0022).",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "labels": { "type": "object", "additionalProperties": { "type": "string" } },
            "groupWait": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
            "groupInterval": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
            "repeatInterval": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
            "slack": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "webhookSecret": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": { "type": "string", "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$", "maxLength": 253 },
                    "key": { "type": "string", "pattern": "^[-._a-zA-Z0-9]+$" }
                  }
                },
                "channel": { "type": "string" },
                "severities": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "enum": ["critical", "warning"] }
                }
              }
            },
            "email": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "to": { "type": "array", "items": { "type": "string", "pattern": "^[^\\s,@]+@[^\\s,@]+$" } },
                "from": { "type": "string" },
                "smarthost": { "type": "string", "pattern": "^(\\S+:[0-9]+)?$" },
                "authUsername": { "type": "string" },
                "authPasswordSecret": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": { "type": "string", "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$", "maxLength": 253 },
                    "key": { "type": "string", "pattern": "^[-._a-zA-Z0-9]+$" }
                  }
                },
                "requireTLS": { "type": "boolean" },
                "severities": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "enum": ["critical", "warning"] }
                }
              }
            },
            "msteams": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "webhookSecret": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": { "type": "string", "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$", "maxLength": 253 },
                    "key": { "type": "string", "pattern": "^[-._a-zA-Z0-9]+$" }
                  }
                },
                "severities": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "enum": ["critical", "warning"] }
                }
              }
            },
            "webhook": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "urlSecret": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": { "type": "string", "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$", "maxLength": 253 },
                    "key": { "type": "string", "pattern": "^[-._a-zA-Z0-9]+$" }
                  }
                },
                "severities": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "enum": ["critical", "warning"] }
                }
              }
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "description": "NetworkPolicies that keep MCP traffic on the Gateway path (SPEC-0007).",
      "additionalProperties": false,
      "properties": {
        "mcpServers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "namespaces": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 63,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              }
            }
          }
        },
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "allowedNamespaceLabels": {
              "type": "array",
              "items": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": { "type": "string" }
              }
            },
            "allowedCIDRs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])|[0-9a-fA-F:]+:[0-9a-fA-F:]*/([0-9]|[1-9][0-9]|1[01][0-9]|12[0-8]))$"
              }
            }
          }
        }
      }
    }
  }
}
