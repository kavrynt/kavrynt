{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Kavrynt Gateway chart values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "duration": {
      "type": "string",
      "description": "Go duration, for example 30s or 1m30s.",
      "pattern": "^(0|([0-9]+(\\.[0-9]+)?(ns|us|\u00b5s|ms|s|m|h))+)$"
    },
    "listenAddress": {
      "type": "string",
      "description": "host:port; an empty host listens on every interface.",
      "pattern": "^[^\\s]*:[0-9]{1,5}$"
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      }
    }
  },
  "properties": {
    "global": {
      "type": "object",
      "description": "Shared with the umbrella chart; other keys are allowed for platform-injected globals.",
      "properties": {
        "watchNamespaces": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
          }
        }
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 2
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 2
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxUnavailable": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string",
              "pattern": "^[1-9][0-9]?%$"
            }
          ]
        }
      }
    },
    "topologySpreadConstraints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "image": {
      "$ref": "#/definitions/image"
    },
    "imagePullSecrets": {
      "$ref": "#/definitions/imagePullSecrets"
    },
    "serviceAccount": {
      "$ref": "#/definitions/serviceAccount"
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "addr": {
          "$ref": "#/definitions/listenAddress"
        },
        "requestTimeout": {
          "$ref": "#/definitions/duration"
        },
        "stripRequestHeaders": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9!#$%&'*+.^_`|~-]+$"
          }
        },
        "allowedOrigins": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https?://[^/\\s,]+/?$"
          }
        },
        "watchNamespaces": {
          "description": "Removed: use global.watchNamespaces. Kept so rendering fails with a message that says so."
        },
        "shutdownDelay": {
          "type": "string",
          "description": "Whole seconds, for example 5s.",
          "pattern": "^[0-9]+s$"
        },
        "shutdownTimeout": {
          "type": "string",
          "description": "Whole seconds, for example 5s.",
          "pattern": "^[1-9][0-9]*s$"
        },
        "strictProtocol": {
          "type": "boolean",
          "description": "Refuse requests that are not well-formed MCP Streamable HTTP (SPEC-0018)."
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "resourceURL": {
          "type": "string",
          "pattern": "^(https://[^/?#\\s@]+/?)?$"
        },
        "issuers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "issuer"
            ],
            "properties": {
              "issuer": {
                "type": "string",
                "pattern": "^https?://\\S+$"
              },
              "jwksURI": {
                "type": "string",
                "pattern": "^(https?://\\S+)?$"
              },
              "allowHTTP": {
                "type": "boolean"
              },
              "tokenExchange": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "clientID",
                  "clientSecretKey"
                ],
                "properties": {
                  "clientID": {
                    "type": "string",
                    "minLength": 1
                  },
                  "clientSecretKey": {
                    "type": "string",
                    "pattern": "^[-_a-zA-Z0-9][-._a-zA-Z0-9]{0,252}$"
                  },
                  "tokenEndpoint": {
                    "type": "string",
                    "pattern": "^(https?://\\S+)?$"
                  }
                }
              }
            }
          }
        },
        "requiredScopes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[\\x21\\x23-\\x5b\\x5d-\\x7e]+$"
          }
        },
        "tokenExchangeSecret": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$"
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "queueSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "onOverflow": {
          "type": "string",
          "enum": [
            "reject",
            "drop"
          ]
        },
        "cloud": {
          "type": "object",
          "description": "Audit delivery to Kavrynt Cloud (SPEC-0017).",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "url": {
              "type": "string",
              "pattern": "^(https://[^\\s?#@]+)?$"
            },
            "tokenSecret": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "key": {
                  "type": "string",
                  "pattern": "^[-._a-zA-Z0-9]+$"
                }
              }
            },
            "bufferSize": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "configMap": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$"
        },
        "filterToolsList": {
          "type": "boolean"
        }
      }
    },
    "console": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "existingSecret": {
              "type": "string",
              "pattern": "^$|^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$"
            },
            "sessionTTL": {
              "$ref": "#/definitions/duration"
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scrapeAnnotations": {
          "type": "boolean"
        },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "$ref": "#/definitions/duration"
            },
            "labels": {
              "$ref": "#/definitions/stringMap"
            }
          }
        },
        "dashboard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "namespace": {
              "type": "string"
            },
            "labels": {
              "$ref": "#/definitions/stringMap"
            },
            "extra": {
              "type": "object",
              "description": "Custom dashboards by file name (SPEC-0023-R02).",
              "propertyNames": {
                "pattern": "^[a-z0-9][a-z0-9-]{0,40}\\.json$"
              },
              "additionalProperties": {
                "type": ["string", "object"]
              }
            }
          }
        }
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "$ref": "#/definitions/stringMap"
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    }
  }
}
