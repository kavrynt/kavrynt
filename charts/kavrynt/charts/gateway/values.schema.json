{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Kavrynt Gateway chart values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "duration": {
      "type": "string",
      "description": "Go duration, for example 30s or 1m30s.",
      "pattern": "^(0|([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+)$"
    },
    "listenAddress": {
      "type": "string",
      "description": "host:port; an empty host listens on every interface.",
      "pattern": "^[^\\s]*:[0-9]{1,5}$"
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" }
      }
    }
  },
  "properties": {
    "global": {
      "type": "object",
      "description": "Shared with the umbrella chart; other keys are allowed for platform-injected globals.",
      "properties": {
        "watchNamespaces": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
          }
        }
      }
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "replicaCount": { "type": "integer", "minimum": 0 },
    "image": { "$ref": "#/definitions/image" },
    "imagePullSecrets": { "$ref": "#/definitions/imagePullSecrets" },
    "serviceAccount": { "$ref": "#/definitions/serviceAccount" },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "create": { "type": "boolean" } }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "addr": { "$ref": "#/definitions/listenAddress" },
        "requestTimeout": { "$ref": "#/definitions/duration" },
        "stripRequestHeaders": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Za-z0-9!#$%&'*+.^_`|~-]+$" }
        },
        "allowedOrigins": {
          "type": "array",
          "items": { "type": "string", "pattern": "^https?://[^/\\s,]+/?$" }
        },
        "watchNamespaces": {
          "description": "Removed: use global.watchNamespaces. Kept so rendering fails with a message that says so."
        }
      }
    },
    "console": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": { "type": "boolean" } }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scrapeAnnotations": { "type": "boolean" },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "interval": { "$ref": "#/definitions/duration" },
            "labels": { "$ref": "#/definitions/stringMap" }
          }
        },
        "dashboard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "namespace": { "type": "string" },
            "labels": { "$ref": "#/definitions/stringMap" }
          }
        }
      }
    },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "resources": { "type": "object" },
    "nodeSelector": { "$ref": "#/definitions/stringMap" },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "affinity": { "type": "object" }
  }
}
